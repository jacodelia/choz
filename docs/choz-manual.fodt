   <text:h text:style-name="P2" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2379_3455341890"/>CHOZ<text:bookmark-end text:name="__RefHeading___Toc2379_3455341890"/></text:h>
   <text:p text:style-name="P3">User Guide</text:p>
   <text:p text:style-name="Cuerpo_20_de_20_texto.sub">Version 1.3.<text:span text:style-name="T1">16</text:span> · Linux (ALSA / JACK / PipeWire)</text:p>
   <text:p text:style-name="Text_20_body"> </text:p>
   <text:p text:style-name="Text_20_body"/>
